<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="制件信息"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- 配比信息 -->
        <TextView
            android:id="@+id/tvMixRatioInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="配比：配比1"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- 拌合参数 -->
        <TextView
            android:id="@+id/tvMixingParams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="拌合参数：温度=160℃, 速度=60rpm, 时间=2min"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- 压实方法 -->
        <TextView
            android:id="@+id/tvCompactionMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="压实方法：振动压实"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- 拌合设备 -->
        <TextView
            android:id="@+id/tvMixingDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="拌合设备：设备A"
            android:textColor="#666666"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- 压实设备 -->
        <TextView
            android:id="@+id/tvFormingDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="压实设备：设备B"
            android:textColor="#666666"
            android:textSize="14sp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
