<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="制件"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 补充标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="生成试件码"
        android:textColor="#666666"
        android:textSize="14sp"
        android:textStyle="normal" />

    <!-- 步进导航 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingVertical="16dp"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="24dp"
            android:gravity="center">

            <!-- 步骤1：扫描加工设备码 -->
            <LinearLayout
                android:id="@+id/step1Layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/step1Indicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/step_circle_active"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/step1Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="扫描加工设备码"
                    android:textColor="#1976D2"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <View
                android:id="@+id/step1Line"
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:background="#1976D2"
                android:layout_gravity="center_vertical"/>

            <!-- 步骤2：生成试件码 -->
            <LinearLayout
                android:id="@+id/step2Layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/step2Indicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/step_circle_active"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/step2Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="生成试件码"
                    android:textColor="#1976D2"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- 内容区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F5F5F5"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 制件信息列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSpecimenInfos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false"/>

            <!-- 试件码预览卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="试件码预览"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- 二维码滑动区域 -->
                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerQRCodes"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:background="#F5F5F5"
                        android:layout_marginBottom="16dp"/>

                    <!-- 页面指示器 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvCurrentPage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#333333"
                            android:textSize="14sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / "
                            android:textColor="#333333"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvTotalPages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textColor="#333333"
                            android:textSize="14sp"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvQRCodeContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="制件方法 1"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:gravity="center"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateQRCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="打印试件码"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"
            android:padding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveQRCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="保存并分享试件码"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"
            app:backgroundTint="#00897B"
            android:padding="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:text="完成制件"
            android:textColor="@android:color/white"
            app:cornerRadius="24dp"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>