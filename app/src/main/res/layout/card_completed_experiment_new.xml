<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 实验类型与名称 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            
            <TextView
                android:id="@+id/tvExperimentType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实验类型"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:background="@drawable/bg_rounded_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp"/>
                
            <TextView
                android:id="@+id/tvExperimentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="实验名称"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?android:textColorPrimary"/>
        </LinearLayout>
        
        <!-- 任务ID -->
        <TextView
            android:id="@+id/tvTaskId"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"
            android:text="任务ID: TK12345678"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
            
        <!-- 任务指派信息 -->
        <TextView
            android:id="@+id/tvTaskAssignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="任务指派信息"
            android:textSize="14sp"
            android:layout_marginBottom="4dp"/>
        
        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginVertical="8dp"/>
            
        <!-- 实验人和时间信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实验人："
                android:textSize="14sp"/>
                
            <TextView
                android:id="@+id/tvExperimenter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="张三"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="接受时间："
                android:textSize="14sp"/>
                
            <TextView
                android:id="@+id/tvAcceptTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2023-01-01 12:00"
                android:textSize="14sp"/>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="完成时间："
                android:textSize="14sp"/>
                
            <TextView
                android:id="@+id/tvCompletionTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2023-01-02 15:30"
                android:textSize="14sp"/>
        </LinearLayout>
        
        <!-- 混合料特有信息 -->
        <LinearLayout
            android:id="@+id/llMixtureInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">
            
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginVertical="8dp"/>
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="配比信息"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="配比名称："
                    android:textSize="14sp"/>
                    
                <TextView
                    android:id="@+id/tvMixName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="查干湖"
                    android:textSize="14sp"/>
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="压实方法："
                    android:textSize="14sp"/>
                    
                <TextView
                    android:id="@+id/tvCompactionMethod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="震动压实"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>
        
        <!-- 沥青特有信息 -->
        <LinearLayout
            android:id="@+id/llAsphaltInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">
            
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginVertical="8dp"/>
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="实验详情"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>
                
            <TextView
                android:id="@+id/tvAsphaltExperimentType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="针入度"
                android:textSize="14sp"
                android:layout_marginBottom="4dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
