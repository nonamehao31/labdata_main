<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 配料信息模块 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="配料信息"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp"/>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartMaterials"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"/>

                <Button
                    android:id="@+id/btnMaterialDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查看配料详情"
                    android:textColor="@android:color/white"
                    android:background="@color/blue_theme"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 制件方式模块 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="制件方式"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayoutMoldingMethods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    app:tabTextColor="@color/gray_text"
                    app:tabIndicatorColor="@color/blue_theme"/>

                <FrameLayout
                    android:id="@+id/fragmentContainerMoldingMethod"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@android:color/white"/>

                <Button
                    android:id="@+id/btnPrintSpecimenCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="打印试件码"
                    android:textColor="@android:color/white"
                    android:background="@color/blue_theme"
                    android:layout_marginTop="8dp"/>

                <EditText
                    android:id="@+id/etPrintQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="输入打印数量"
                    android:inputType="number"
                    android:background="@android:color/white"
                    android:padding="8dp"
                    android:textColor="@color/gray_text"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 实验任务模块 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="实验任务"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/blue_700"
                    android:layout_marginBottom="8dp"/>

                <!-- 在这里可以添加实验任务的具体信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvExperimentDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gray_text"/>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
